# Ambiente: development | test | production
NODE_ENV=development

# Porta HTTP da aplicação
PORT=3000

# Caminho do arquivo SQLite (a pasta é criada automaticamente)
DATABASE_PATH=data/database.sqlite

# Origens permitidas para CORS, separadas por vírgula.
# Vazio = CORS desabilitado (o frontend é servido pela mesma origem).
CORS_ORIGIN=

# Nível de log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Máximo de requisições por IP, por minuto, na API
RATE_LIMIT_MAX=100
